# Required for the AI loops (RFx drafting, document extraction, analysis routing).
# Without it the platform still runs: extraction falls back to deterministic parsing
# and every screen states that it is in fallback mode.
GOOGLE_API_KEY=

# Optional. Any structured-output-capable Gemini model your account can reach.
GEMINI_MODEL=gemini-3.8-flash

# Optional. Where the SQLite snapshots, uploads and knowledge dossiers are written.
# Defaults to ./runtime. On Railway, point this at a mounted volume so the data
# survives a redeploy, e.g. AERCHAIN_DATA_DIR=/data
AERCHAIN_DATA_DIR=
